<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.0/phpunit.xsd"
         bootstrap="src/Awyiss/Tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         displayDetailsOnTestsThatTriggerWarnings="true"
         beStrictAboutTestsThatDoNotTestAnything="false"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Awyiss PHPCS Sniffs">
            <file>src/Awyiss/Tests/Arrays/NoInlineCommentedArrayItemUnitTest.php</file>
            <file>src/Awyiss/Tests/Classes/ClassMemberSpacingUnitTest.php</file>
            <file>src/Awyiss/Tests/Commenting/SeeUsesTagSpacingUnitTest.php</file>
            <file>src/Awyiss/Tests/Commenting/VariableCommentUnitTest.php</file>
            <file>src/Awyiss/Tests/Functions/ArrowFunctionDeclarationUnitTest.php</file>
            <file>src/Awyiss/Tests/Operators/MethodChainingUnitTest.php</file>
            <file>src/Awyiss/Tests/WhiteSpace/ArrayUnionIndentationUnitTest.php</file>
            <file>src/Awyiss/Tests/WhiteSpace/ConstantDeclarationSpacingUnitTest.php</file>
            <file>src/Awyiss/Tests/WhiteSpace/SemicolonSpacingUnitTest.php</file>
            <file>src/Awyiss/Tests/WhiteSpace/SingleArgumentNotMultilineUnitTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>

