{
  "name": "awyiss/phpcs-sniffs",
  "description": "Custom PHP_CodeSniffer standard and sniffs for Awyiss projects",
  "type": "phpcodesniffer-standard",
  "license": "MIT",
  "keywords": [
    "phpcs",
    "php_codesniffer",
    "coding-standard",
    "sniffs"
  ],
  "require": {
    "php": ">=8.4",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "squizlabs/php_codesniffer": "^4.0.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Awyiss\\": "Awyiss/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Awyiss\\Tests\\": "Awyiss/Tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs -p --standard=ruleset.xml Awyiss/Sniffs",
    "lint:tests": "phpcs -p --standard=ruleset.xml Awyiss/Tests",
    "test": "phpunit --colors=always"
  }
}

